# Optional Supabase connection (not required for the demo UI)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Future AI provider routing
AI_PROVIDER=
AI_API_KEY=

# Shared secret for the scheduled-monitoring worker (/api/monitoring/run). Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`. Without it the scheduler stays disabled.
CRON_SECRET=
