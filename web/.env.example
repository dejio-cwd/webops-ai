# WebOps AI — environment variables
# Copy to .env.local for local dev, or add these in Vercel → Settings → Environment Variables.
# EVERYTHING WORKS WITH NO KEYS SET. Keys only unlock higher quotas / AI features.

# --- Performance (Core Web Vitals via Google PageSpeed Insights) ---
# Optional. Without a key you get Google's lower keyless quota. Get one free at:
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- AI copilot (set ANY ONE to enable Explain / Fix / Summary) ---
# OpenRouter gives access to many models incl. free ones: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional defaults for the AI copilot
# AI_PROVIDER=openrouter
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Optional Supabase (future persistence phase; not required to run) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
