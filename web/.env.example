# WebOps AI — environment variables
PAGESPEED_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
AI_PROVIDER=
AI_MODEL=

# Supabase production foundation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Enable after the sign-in UI and Supabase project are configured.
SECURITY_ENFORCE_AUTH=false

# Optional comma-separated host allowlist for custom AI endpoints.
AI_CUSTOM_ENDPOINT_ALLOWLIST=

# Server-side envelope encryption key reference. Use a KMS-managed secret in production.
CREDENTIAL_ENCRYPTION_KEY=
